{"p": "9.10.040", "q": "No person shall operate as a sidewalk vendor without a valid permit issued under this chapter.", "sig": {"type": "standing", "text": "No person shall … without a valid permit"}, "actor": "ACT-any-person|No person", "mod": "prohibition", "act": ["operate as sidewalk vendor", "without a valid permit issued under this chapter"], "cp": "ACT-public?"}
{"p": "9.10.050.A", "q": "An applicant for a sidewalk vending permit shall file a written application with the director on a form provided by the director.", "sig": {"type": "state", "text": "applicant seeks a sidewalk vending permit"}, "actor": "ACT-applicant|An applicant", "mod": "duty", "act": ["file", "written application, on director-provided form"], "cp": "ACT-director|the director", "out": ["artifact:application"]}
{"p": "9.10.050.C", "q": "The director shall review each application for completeness within five business days after it is filed.", "sig": {"type": "upstream_action", "text": "after it is filed", "ref": "9.10.050.A"}, "actor": "ACT-director|The director", "mod": "duty", "act": ["review", "each application for completeness"], "cp": "ACT-applicant?", "time": {"kind": "deadline", "amount": 5, "unit": "days", "from": "signal", "direction": "after", "business_days": true, "text": "within five business days after it is filed"}, "out": ["artifact:completeness-determination"]}
{"p": "9.10.050.D", "q": "A certificate of insurance shall be submitted before a permit is issued.", "sig": {"type": "unknown", "text": null}, "actor": null, "mod": "duty", "act": ["submit", "certificate of insurance"], "time": {"kind": "deadline", "from": "issuance", "direction": "before", "text": "before a permit is issued"}, "out": ["artifact:insurance-certificate"], "flags": ["O-SIG", "O-ACT"]}
{"p": "9.10.060.A", "q": "Within ten business days after an application is determined complete, the director shall issue or deny the permit.", "sig": {"type": "upstream_action", "text": "after an application is determined complete", "ref": "9.10.050.C"}, "actor": "ACT-director|the director", "mod": "duty", "act": ["issue or deny", "the permit"], "cp": "ACT-applicant?", "time": {"kind": "deadline", "amount": 10, "unit": "days", "from": "signal", "direction": "after", "business_days": true, "text": "Within ten business days after an application is determined complete"}, "out": ["artifact:permit", "artifact:denial"]}
{"p": "9.10.060.B", "q": "The director shall deny the permit if the applicant has an unpaid fine under this chapter.", "sig": {"type": "state", "text": "the applicant has an unpaid fine under this chapter"}, "actor": "ACT-director|The director", "mod": "duty", "act": ["deny", "the permit"], "cp": "ACT-applicant?", "cond": ["applicant has an unpaid fine under this chapter"], "out": ["artifact:denial"]}
{"p": "9.10.060.C", "q": "The director or the director's designee shall notify the applicant of a denial in writing, stating the reasons.", "sig": {"type": "upstream_action", "text": "a denial", "ref": "9.10.060.A"}, "actor": "ACT-director|The director", "mod": "duty", "act": ["notify", "the applicant of a denial in writing, stating the reasons"], "cp": "ACT-applicant?", "out": ["artifact:denial-notice"], "link": {"id": "L-9.10.060.C", "rel": "alternative"}}
{"p": "9.10.060.C", "q": "The director or the director's designee shall notify the applicant of a denial in writing, stating the reasons.", "sig": {"type": "upstream_action", "text": "a denial", "ref": "9.10.060.A"}, "actor": "ACT-director-designee|the director's designee", "mod": "duty", "act": ["notify", "the applicant of a denial in writing, stating the reasons"], "cp": "ACT-applicant?", "out": ["artifact:denial-notice"], "link": {"id": "L-9.10.060.C", "rel": "alternative"}}
{"p": "9.10.070.B", "q": "The permittee shall renew the permit annually.", "sig": {"type": "unknown", "text": null}, "actor": "ACT-permittee|The permittee", "mod": "duty", "act": ["renew", "the permit annually"], "cp": "ACT-director?", "flags": ["O-SIG"]}
{"p": "9.10.070.C", "q": "A permittee shall file a renewal application with the director at least thirty days before the permit expires.", "sig": {"type": "time", "text": "at least thirty days before the permit expires"}, "actor": "ACT-permittee|A permittee", "mod": "duty", "act": ["file", "renewal application"], "cp": "ACT-director|the director", "time": {"kind": "deadline", "amount": 30, "unit": "days", "from": "permit expiry", "direction": "before", "text": "at least thirty days before the permit expires"}, "out": ["artifact:renewal-application"]}
{"p": "9.10.070.D", "q": "The director shall act on a renewal application in the manner provided in Section 9.10.060.", "sig": {"type": "upstream_action", "text": "a renewal application", "ref": "9.10.070.C"}, "actor": "ACT-director|The director", "mod": "duty", "act": ["act on", "renewal application, as provided in Section 9.10.060"], "cp": "ACT-permittee?", "out": ["artifact:permit"]}
{"p": "9.10.080.A", "q": "A sidewalk vendor shall display the permit in a conspicuous place on the vending cart at all times while vending.", "sig": {"type": "state", "text": "while vending"}, "actor": "ACT-sidewalk-vendor|A sidewalk vendor", "mod": "duty", "act": ["display", "the permit in a conspicuous place on the vending cart"], "cp": "ACT-public?", "time": {"kind": "continuous", "text": "at all times while vending"}}
{"p": "9.10.080.B", "q": "No sidewalk vendor shall vend within one hundred feet of an elementary school entrance during school hours.", "sig": {"type": "standing", "text": "No sidewalk vendor shall vend …"}, "actor": "ACT-sidewalk-vendor|sidewalk vendor", "mod": "prohibition", "act": ["vend", "within one hundred feet of an elementary school entrance during school hours"], "cp": "ACT-public?", "cond": ["within 100 feet of an elementary school entrance", "during school hours"]}
{"p": "9.10.080.C", "q": "Each vendor shall ensure compliance with all applicable health regulations.", "sig": {"type": "standing", "text": "Each vendor shall ensure …"}, "actor": "ACT-sidewalk-vendor|Each vendor", "mod": "duty", "act": ["ensure compliance", "with all applicable health regulations"], "cp": "ACT-public?", "flags": ["O-VERB"]}
{"p": "9.10.080.D", "q": "A permittee may operate between the hours of 7:00 a.m. and 9:00 p.m.", "sig": {"type": "standing", "text": "A permittee may operate …"}, "actor": "ACT-permittee|A permittee", "mod": "permission", "act": ["operate", "between 7:00 a.m. and 9:00 p.m."], "time": {"kind": "window", "text": "between 7:00 a.m. and 9:00 p.m."}}
{"p": "9.10.080.E", "q": "No vending cart shall exceed four feet in width.", "sig": {"type": "standing", "text": "No vending cart shall exceed …"}, "actor": "ACT-sidewalk-vendor|vending cart (operated by the vendor)", "mod": "prohibition", "act": ["use a cart exceeding", "four feet in width"], "cp": "ACT-public?", "flags": ["O-CONFLICT"], "conflict": ["9.10.100"]}
{"p": "9.10.090.A", "q": "The director may, by written order, designate streets on which sidewalk vending is prohibited.", "sig": {"type": "discretionary", "text": "The director may …"}, "actor": "ACT-director|The director", "mod": "power", "act": ["designate", "streets on which sidewalk vending is prohibited, by written order"], "cp": "ACT-public?", "out": ["artifact:street-designation-order"]}
{"p": "9.10.090.B", "q": "No sidewalk vendor shall vend on a street designated under subsection A.", "sig": {"type": "upstream_action", "text": "a street designated under subsection A", "ref": "9.10.090.A"}, "actor": "ACT-sidewalk-vendor|sidewalk vendor", "mod": "prohibition", "act": ["vend", "on a designated street"], "cp": "ACT-public?"}
{"p": "9.10.100", "q": "Vending carts shall not exceed five feet in width.", "sig": {"type": "standing", "text": "Vending carts shall not exceed …"}, "actor": "ACT-sidewalk-vendor|Vending carts (operated by the vendor)", "mod": "prohibition", "act": ["use a cart exceeding", "five feet in width"], "cp": "ACT-public?", "flags": ["O-CONFLICT"], "conflict": ["9.10.080.E"]}
{"p": "9.10.110", "q": "A sidewalk vendor who sells food shall obtain a health certificate from the county health department pursuant to Section 9.10.135 before vending.", "sig": {"type": "state", "text": "sells food"}, "actor": "ACT-sidewalk-vendor|A sidewalk vendor who sells food", "mod": "duty", "act": ["obtain", "a health certificate from the county health department, pursuant to Section 9.10.135"], "cp": "ACT-county-health-department|the county health department", "time": {"kind": "deadline", "from": "vending", "direction": "before", "text": "before vending"}, "flags": ["O-XREF"]}
{"p": "9.10.120.B", "q": "Upon observing a violation of this chapter, a code enforcement officer shall issue a written citation to the vendor.", "sig": {"type": "event", "text": "Upon observing a violation of this chapter"}, "actor": "ACT-code-enforcement-officer|a code enforcement officer", "mod": "duty", "act": ["issue", "a written citation"], "cp": "ACT-sidewalk-vendor|the vendor", "out": ["artifact:citation"]}
{"p": "9.10.120.C", "q": "A person who is issued a citation shall pay a fine of one hundred dollars within thirty days after the citation is issued.", "sig": {"type": "upstream_action", "text": "the citation is issued", "ref": "9.10.120.B"}, "actor": "ACT-cited-person|A person who is issued a citation", "mod": "duty", "act": ["pay", "a fine of one hundred dollars"], "cp": "ACT-city?", "time": {"kind": "deadline", "amount": 30, "unit": "days", "from": "signal", "direction": "after", "text": "within thirty days after the citation is issued"}, "out": ["artifact:fine-payment"]}
{"p": "9.10.130.A", "q": "A person who receives a citation may appeal to the hearing officer within fifteen days after receipt of the citation.", "sig": {"type": "upstream_action", "text": "receipt of the citation", "ref": "9.10.120.B"}, "actor": "ACT-cited-person|A person who receives a citation", "mod": "permission", "act": ["appeal", "the citation"], "cp": "ACT-hearing-officer|the hearing officer", "time": {"kind": "deadline", "amount": 15, "unit": "days", "from": "signal", "direction": "after", "text": "within fifteen days after receipt of the citation"}, "out": ["artifact:appeal"]}
{"p": "9.10.130.B", "q": "The hearing officer may hold a hearing within thirty days after an appeal is filed.", "sig": {"type": "upstream_action", "text": "an appeal is filed", "ref": "9.10.130.A"}, "actor": "ACT-hearing-officer|The hearing officer", "mod": "permission", "act": ["hold", "a hearing"], "cp": "ACT-cited-person?", "time": {"kind": "deadline", "amount": 30, "unit": "days", "from": "signal", "direction": "after", "text": "within thirty days after an appeal is filed"}, "out": ["artifact:hearing"], "flags": ["O-AMBIG"]}
{"p": "9.10.130.C", "q": "The hearing officer may affirm, modify, or dismiss the citation.", "sig": {"type": "upstream_action", "text": "the hearing", "ref": "9.10.130.B"}, "actor": "ACT-hearing-officer|The hearing officer", "mod": "power", "act": ["affirm, modify, or dismiss", "the citation"], "cp": "ACT-cited-person?", "out": ["artifact:hearing-decision"]}
{"p": "9.10.130.D", "q": "If the hearing officer affirms the citation, the person shall pay the fine within ten days after the decision.", "sig": {"type": "upstream_action", "text": "the hearing officer affirms the citation", "ref": "9.10.130.C"}, "actor": "ACT-cited-person|the person", "mod": "duty", "act": ["pay", "the fine"], "cp": "ACT-city?", "time": {"kind": "deadline", "amount": 10, "unit": "days", "from": "signal", "direction": "after", "text": "within ten days after the decision"}, "cond": ["hearing officer affirms the citation"], "out": ["artifact:fine-payment"]}
{"p": "9.10.140.A", "q": "The director may revoke a permit if the permittee has been cited for three or more violations within any twelve month period.", "sig": {"type": "state", "text": "the permittee has been cited for three or more violations within any twelve month period"}, "actor": "ACT-director|The director", "mod": "power", "act": ["revoke", "a permit"], "cp": "ACT-permittee?", "cond": ["permittee cited for three or more violations within any twelve month period"], "out": ["artifact:revocation"]}
{"p": "9.10.140.B", "q": "The director shall give written notice of revocation to the permittee.", "sig": {"type": "upstream_action", "text": "revocation", "ref": "9.10.140.A"}, "actor": "ACT-director|The director", "mod": "duty", "act": ["give", "written notice of revocation"], "cp": "ACT-permittee|the permittee", "out": ["artifact:revocation-notice"]}
{"p": "9.10.140.C", "q": "A permittee shall surrender a revoked permit to the director upon receipt of the notice of revocation.", "sig": {"type": "upstream_action", "text": "receipt of the notice of revocation", "ref": "9.10.140.B"}, "actor": "ACT-permittee|A permittee", "mod": "duty", "act": ["surrender", "the revoked permit"], "cp": "ACT-director|the director"}
