# FERPA 34 CFR Part 99: school official exception and the provisions it depends on
{"p": "99.4", "q": "An educational agency or institution shall give full rights under the Act to either parent, unless the agency or institution has been provided with evidence that there is a court order, State statute, or legally binding document relating to such matters as divorce, separation, or custody that specifically revokes these rights.", "sig": {"type": "standing", "text": "An educational agency or institution shall give full rights …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["give full rights under the Act to", "either parent"], "cp": "ACT-parent?", "cond": ["unless the agency or institution has been provided with evidence of a court order, State statute, or legally binding document (divorce, separation, custody) that specifically revokes these rights"]}
{"p": "99.5.a.2", "q": "Nothing in this section prevents an educational agency or institution from disclosing education records, or personally identifiable information from education records, to a parent without the prior written consent of an eligible student", "sig": {"type": "discretionary", "text": "Nothing in this section prevents …"}, "actor": "ACT-educational-agency-or-institution|an educational agency or institution", "mod": "permission", "act": ["disclose", "education records, or personally identifiable information from them, to a parent without the prior written consent of an eligible student"], "cp": "ACT-parent|a parent", "cond": ["the disclosure meets the conditions in § 99.31(a)(8), § 99.31(a)(10), § 99.31(a)(15), or any other provision in § 99.31(a)"]}
{"p": "99.5.b", "q": "The Act and this part do not prevent educational agencies or institutions from giving students rights in addition to those given to parents.", "sig": {"type": "discretionary", "text": "The Act and this part do not prevent …"}, "actor": "ACT-educational-agency-or-institution|educational agencies or institutions", "mod": "permission", "act": ["give students", "rights in addition to those given to parents"], "cp": "ACT-student|students"}
{"p": ["99.7.a.1", "99.7.a.2", "99.7.a.2.i", "99.7.a.2.ii", "99.7.a.2.iii", "99.7.a.2.iv", "99.7.a.3", "99.7.a.3.i", "99.7.a.3.ii"], "q": "Each educational agency or institution shall annually notify parents of students currently in attendance, or eligible students currently in attendance, of their rights under the Act and this part.", "sig": {"type": "time", "text": "annually"}, "actor": "ACT-educational-agency-or-institution|Each educational agency or institution", "mod": "duty", "act": ["notify", "parents of students in attendance, or eligible students in attendance, of their rights under the Act and Part 99; the notice must say they may inspect and review education records, seek amendment, consent to disclosures (except as § 99.31 allows) and file a complaint with the Department, and must give the procedures for inspection and for amendment under § 99.20"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "time": {"kind": "recurrence", "text": "annually"}, "out": ["artifact:annual-notification"]}
{"p": "99.7.a.3.iii", "q": "If the educational agency or institution has a policy of disclosing education records under § 99.31(a)(1), a specification of criteria for determining who constitutes a school official and what constitutes a legitimate educational interest.", "sig": {"type": "state", "text": "the agency or institution has a policy of disclosing education records under § 99.31(a)(1)"}, "actor": null, "mod": "duty", "act": ["specify in the annual notice", "criteria for determining who constitutes a school official and what constitutes a legitimate educational interest"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "out": ["artifact:school-official-criteria"], "flags": ["O-ACT", "O-AMBIG"]}
{"p": "99.7.b", "q": "An educational agency or institution may provide this notice by any means that are reasonably likely to inform the parents or eligible students of their rights.", "sig": {"type": "discretionary", "text": "An educational agency or institution may provide this notice …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "permission", "act": ["provide the notice", "by any means reasonably likely to inform the parents or eligible students of their rights"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.7.b.1", "q": "An educational agency or institution shall effectively notify parents or eligible students who are disabled.", "sig": {"type": "state", "text": "the parents or eligible students are disabled"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["effectively notify", "parents or eligible students who are disabled"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.7.b.2", "q": "An agency or institution of elementary or secondary education shall effectively notify parents who have a primary or home language other than English.", "sig": {"type": "state", "text": "the parents have a primary or home language other than English"}, "actor": "ACT-educational-agency-or-institution|An agency or institution of elementary or secondary education", "mod": "duty", "act": ["effectively notify", "parents who have a primary or home language other than English"], "cp": "ACT-parent|parents"}
{"p": ["99.30.a", "99.30.b", "99.30.b.1", "99.30.b.2", "99.30.b.3"], "q": "The parent or eligible student shall provide a signed and dated written consent before an educational agency or institution discloses personally identifiable information from the student’s education records, except as provided in § 99.31.", "sig": {"type": "state", "text": "an educational agency or institution is to disclose personally identifiable information from the student’s education records"}, "actor": "ACT-parent-or-eligible-student|The parent or eligible student", "mod": "duty", "act": ["provide", "a signed and dated written consent that specifies the records that may be disclosed, states the purpose of the disclosure, and identifies the party or class of parties to whom the disclosure may be made"], "cp": "ACT-educational-agency-or-institution?", "time": {"kind": "deadline", "direction": "before", "text": "before an educational agency or institution discloses personally identifiable information"}, "cond": ["except as provided in § 99.31"], "out": ["artifact:written-consent"], "flags": ["O-AMBIG"]}
{"p": ["99.30.c.1", "99.30.c"], "q": "If a parent or eligible student so requests, the educational agency or institution shall provide him or her with a copy of the records disclosed", "sig": {"type": "request", "text": "a parent or eligible student requests a copy after a disclosure under paragraph (a)"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution", "mod": "duty", "act": ["provide", "a copy of the records disclosed"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.30.c.2", "q": "If the parent of a student who is not an eligible student so requests, the agency or institution shall provide the student with a copy of the records disclosed.", "sig": {"type": "request", "text": "the parent of a student who is not an eligible student requests a copy"}, "actor": "ACT-educational-agency-or-institution|the agency or institution", "mod": "duty", "act": ["provide", "the student with a copy of the records disclosed"], "cp": "ACT-student|the student"}
{"p": "99.31.a", "q": "An educational agency or institution may disclose personally identifiable information from an education record of a student without the consent required by § 99.30 if the disclosure meets one or more of the following conditions", "sig": {"type": "discretionary", "text": "An educational agency or institution may disclose …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "permission", "act": ["disclose", "personally identifiable information from an education record of a student without the consent required by § 99.30"], "cp": "ACT-parent-or-eligible-student?", "cond": ["the disclosure meets one or more of the conditions listed in § 99.31(a)"]}
{"p": "99.31.a.1.i.A", "q": "The disclosure is to other school officials, including teachers, within the agency or institution whom the agency or institution has determined to have legitimate educational interests.", "sig": {"type": "discretionary", "text": "disclosure to other school officials within the agency or institution"}, "actor": "ACT-educational-agency-or-institution?", "mod": "permission", "act": ["disclose personally identifiable information", "to other school officials, including teachers, within the agency or institution whom the agency or institution has determined to have legitimate educational interests", "inferred"], "cp": "ACT-school-official|other school officials, including teachers", "cond": ["the agency or institution has determined that the school officials have legitimate educational interests"]}
{"p": ["99.31.a.1.i.B", "99.31.a.1.i.B.1", "99.31.a.1.i.B.2", "99.31.a.1.i.B.3"], "q": "A contractor, consultant, volunteer, or other party to whom an agency or institution has outsourced institutional services or functions may be considered a school official under this paragraph provided that the outside party", "sig": {"type": "state", "text": "an agency or institution has outsourced institutional services or functions to the party"}, "actor": null, "mod": "permission", "act": ["consider as a school official under paragraph (a)(1)(i)", "a contractor, consultant, volunteer, or other party to whom institutional services or functions have been outsourced"], "cp": "ACT-outside-party|A contractor, consultant, volunteer, or other party", "cond": ["the outside party performs an institutional service or function for which the agency or institution would otherwise use employees", "the outside party is under the direct control of the agency or institution with respect to the use and maintenance of education records", "the outside party is subject to the requirements of § 99.33(a) governing the use and redisclosure of personally identifiable information from education records"], "flags": ["O-ACT", "O-AMBIG"]}
{"p": "99.31.a.1.ii", "q": "An educational agency or institution must use reasonable methods to ensure that school officials obtain access to only those education records in which they have legitimate educational interests.", "sig": {"type": "standing", "text": "An educational agency or institution must use reasonable methods …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["use reasonable methods to ensure", "that school officials obtain access to only those education records in which they have legitimate educational interests"], "cp": "ACT-school-official?"}
{"p": "99.31.a.1.ii", "q": "An educational agency or institution that does not use physical or technological access controls must ensure that its administrative policy for controlling access to education records is effective and that it remains in compliance with the legitimate educational interest requirement in paragraph (a)(1)(i)(A) of this section", "sig": {"type": "state", "text": "the agency or institution does not use physical or technological access controls"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution that does not use physical or technological access controls", "mod": "duty", "act": ["ensure", "that its administrative policy for controlling access to education records is effective and that it remains in compliance with the legitimate educational interest requirement in paragraph (a)(1)(i)(A)"]}
{"p": ["99.32.a.1", "99.32.a.3", "99.32.a.3.i", "99.32.a.3.ii"], "q": "An educational agency or institution must maintain a record of each request for access to and each disclosure of personally identifiable information from the education records of each student", "sig": {"type": "event", "text": "a request for access to, or a disclosure of, personally identifiable information from a student’s education records"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["maintain", "a record of each request for access to and each disclosure of personally identifiable information from the education records of each student, including the names of State and local educational authorities and Federal officials and agencies listed in § 99.31(a)(3) that may make further disclosures; the record must name the parties who requested or received the information and the legitimate interests they had"], "cp": "ACT-parent-or-eligible-student?", "out": ["artifact:record-of-disclosures"]}
{"p": "99.32.a.2", "q": "The agency or institution shall maintain the record with the education records of the student as long as the records are maintained.", "sig": {"type": "upstream_action", "text": "the record of requests and disclosures is made", "ref": "99.32.a.1"}, "actor": "ACT-educational-agency-or-institution|The agency or institution", "mod": "duty", "act": ["maintain", "the record with the education records of the student"], "time": {"kind": "continuous", "text": "as long as the records are maintained"}}
{"p": "99.32.a.4", "q": "An educational agency or institution must obtain a copy of the record of further disclosures maintained under paragraph (b)(2) of this section and make it available in response to a parent’s or eligible student’s request to review the record required under paragraph (a)(1) of this section", "sig": {"type": "request", "text": "a parent’s or eligible student’s request to review the record of requests and disclosures"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["obtain and make available", "a copy of the record of further disclosures maintained under paragraph (b)(2)"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": ["99.32.a.5", "99.32.a.5.i", "99.32.a.5.ii"], "q": "An educational agency or institution must record the following information when it discloses personally identifiable information from education records under the health or safety emergency exception in § 99.31(a)(10) and § 99.36", "sig": {"type": "event", "text": "the agency or institution discloses personally identifiable information under the health or safety emergency exception"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["record", "the articulable and significant threat to the health or safety of a student or other individuals that formed the basis for the disclosure, and the parties to whom the information was disclosed"]}
{"p": ["99.32.b.1", "99.32.b.1.i", "99.32.b.1.ii"], "q": "the record of the disclosure required under this section must include", "sig": {"type": "state", "text": "an educational agency or institution discloses personally identifiable information with the understanding authorized under § 99.33(b)"}, "actor": null, "mod": "duty", "act": ["include in the record of the disclosure", "the names of the additional parties to which the receiving party may disclose the information on behalf of the agency or institution, and the legitimate interests under § 99.31 that each has"], "flags": ["O-ACT"]}
{"p": ["99.32.b.2.i", "99.32.b.2.i.A", "99.32.b.2.i.B"], "q": "A State or local educational authority or Federal official or agency listed in § 99.31(a)(3) that makes further disclosures of information from education records under § 99.33(b) must record the names of the additional parties to which it discloses information on behalf of an educational agency or institution and their legitimate interests in the information under § 99.31", "sig": {"type": "state", "text": "it makes further disclosures under § 99.33(b) of information received from an agency or institution that has not recorded them, or from another such authority or official"}, "actor": "ACT-state-or-federal-recipient|A State or local educational authority or Federal official or agency listed in § 99.31(a)(3)", "mod": "duty", "act": ["record", "the names of the additional parties to which it discloses information on behalf of an educational agency or institution, and their legitimate interests"], "cp": "ACT-educational-agency-or-institution?"}
{"p": "99.32.b.2.ii", "q": "A State or local educational authority or Federal official or agency that records further disclosures of information under paragraph (b)(2)(i) of this section may maintain the record by the student’s class, school, district, or other appropriate grouping rather than by the name of the student", "sig": {"type": "upstream_action", "text": "it records further disclosures under paragraph (b)(2)(i)", "ref": "99.32.b.2.i"}, "actor": "ACT-state-or-federal-recipient|A State or local educational authority or Federal official or agency", "mod": "permission", "act": ["maintain", "the record by the student’s class, school, district, or other appropriate grouping rather than by the name of the student"]}
{"p": "99.32.b.2.iii", "q": "Upon request of an educational agency or institution, a State or local educational authority or Federal official or agency listed in § 99.31(a)(3) that maintains a record of further disclosures under paragraph (b)(2)(i) of this section must provide a copy of the record of further disclosures to the educational agency or institution within a reasonable period of time not to exceed 30 days", "sig": {"type": "request", "text": "a request from an educational agency or institution"}, "actor": "ACT-state-or-federal-recipient|a State or local educational authority or Federal official or agency listed in § 99.31(a)(3)", "mod": "duty", "act": ["provide", "a copy of the record of further disclosures to the educational agency or institution"], "cp": "ACT-educational-agency-or-institution|the educational agency or institution", "time": {"kind": "deadline", "amount": 30, "unit": "days", "from": "request", "direction": "after", "text": "within a reasonable period of time not to exceed 30 days"}}
{"p": ["99.32.c.1", "99.32.c"], "q": "The following parties may inspect the record relating to each student", "sig": {"type": "discretionary", "text": "The following parties may inspect …"}, "actor": "ACT-parent-or-eligible-student|The parent or eligible student", "mod": "permission", "act": ["inspect", "the record of requests and disclosures relating to each student"]}
{"p": ["99.32.c.2", "99.32.c"], "q": "The school official or his or her assistants who are responsible for the custody of the records.", "sig": {"type": "discretionary", "text": "The following parties may inspect …"}, "actor": "ACT-records-custodian|The school official or his or her assistants who are responsible for the custody of the records", "mod": "permission", "act": ["inspect", "the record of requests and disclosures relating to each student"]}
{"p": ["99.32.c.3", "99.32.c"], "q": "Those parties authorized in § 99.31(a) (1) and (3) for the purposes of auditing the recordkeeping procedures of the educational agency or institution", "sig": {"type": "discretionary", "text": "The following parties may inspect …"}, "actor": "ACT-authorized-auditors|Those parties authorized in § 99.31(a) (1) and (3)", "mod": "permission", "act": ["inspect", "the record of requests and disclosures relating to each student, for the purposes of auditing the recordkeeping procedures of the educational agency or institution"]}
{"p": "99.33.a.1", "q": "An educational agency or institution may disclose personally identifiable information from an education record only on the condition that the party to whom the information is disclosed will not disclose the information to any other party without the prior consent of the parent or eligible student", "sig": {"type": "discretionary", "text": "An educational agency or institution may disclose … only on the condition that …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "permission", "act": ["disclose", "personally identifiable information from an education record, only on the condition that the party to whom it is disclosed will not disclose it to any other party without the prior consent of the parent or eligible student"], "cp": "ACT-receiving-party|the party to whom the information is disclosed", "flags": ["O-AMBIG"]}
{"p": "99.33.a.1", "q": "the party to whom the information is disclosed will not disclose the information to any other party without the prior consent of the parent or eligible student", "sig": {"type": "upstream_action", "text": "the agency or institution discloses personally identifiable information to the party", "ref": "99.33.a.1"}, "actor": "ACT-receiving-party|the party to whom the information is disclosed", "mod": "prohibition", "act": ["disclose", "the information to any other party without the prior consent of the parent or eligible student"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "flags": ["O-AMBIG"]}
{"p": "99.33.a.2", "q": "The officers, employees, and agents of a party that receives information under paragraph (a)(1) of this section may use the information, but only for the purposes for which the disclosure was made", "sig": {"type": "upstream_action", "text": "a party receives information under paragraph (a)(1)", "ref": "99.33.a.1"}, "actor": "ACT-receiving-party-personnel|The officers, employees, and agents of a party that receives information under paragraph (a)(1)", "mod": "permission", "act": ["use", "the information, but only for the purposes for which the disclosure was made"], "flags": ["O-AMBIG"]}
{"p": ["99.33.b.1", "99.33.b.1.i", "99.33.b.1.ii.A", "99.33.b.1.ii.B"], "q": "Paragraph (a) of this section does not prevent an educational agency or institution from disclosing personally identifiable information with the understanding that the party receiving the information may make further disclosures of the information on behalf of the educational agency or institution", "sig": {"type": "discretionary", "text": "Paragraph (a) of this section does not prevent …"}, "actor": "ACT-educational-agency-or-institution|an educational agency or institution", "mod": "permission", "act": ["disclose", "personally identifiable information with the understanding that the receiving party may make further disclosures on behalf of the agency or institution"], "cp": "ACT-receiving-party|the party receiving the information", "cond": ["the disclosures meet the requirements of § 99.31", "the agency or institution has complied with the requirements of § 99.32(b), or a State or local educational authority or Federal official or agency listed in § 99.31(a)(3) has complied with § 99.32(b)(2)"]}
{"p": "99.33.b.2", "q": "A party that receives a court order or lawfully issued subpoena and rediscloses personally identifiable information from education records on behalf of an educational agency or institution in response to that order or subpoena under § 99.31(a)(9) must provide the notification required under § 99.31(a)(9)(ii)", "sig": {"type": "event", "text": "the party receives a court order or lawfully issued subpoena and rediscloses personally identifiable information on behalf of the agency or institution in response"}, "actor": "ACT-receiving-party|A party that receives a court order or lawfully issued subpoena", "mod": "duty", "act": ["provide", "the notification required under § 99.31(a)(9)(ii)"], "cp": "ACT-parent-or-eligible-student?"}
{"p": "99.33.d", "q": "An educational agency or institution must inform a party to whom disclosure is made of the requirements of paragraph (a) of this section", "sig": {"type": "event", "text": "a disclosure is made to a party"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["inform", "a party to whom disclosure is made of the requirements of paragraph (a)"], "cp": "ACT-receiving-party|a party to whom disclosure is made", "cond": ["except for disclosures made under §§ 99.31(a)(8), (9), (11), (12), (14), (15), and (16), and to information that postsecondary institutions are required to disclose under the Clery Act to the accuser and accused regarding the outcome of any campus disciplinary proceeding brought alleging a sexual offense"]}
# FERPA extension: access, fees, limits, amendment and hearing
{"p": ["99.10.a", "99.10.a.1", "99.10.a.2", "99.10.a.2.i", "99.10.a.2.ii"], "q": "a parent or eligible student must be given the opportunity to inspect and review the student’s education records", "sig": {"type": "standing", "text": "a parent or eligible student must be given the opportunity …"}, "actor": null, "mod": "duty", "act": ["give the opportunity to inspect and review", "the student’s education records"], "cp": "ACT-parent-or-eligible-student|a parent or eligible student", "cond": ["except as limited under § 99.12"], "flags": ["O-ACT"]}
{"p": "99.10.b", "q": "The educational agency or institution, or SEA or its component, shall comply with a request for access to records within a reasonable period of time, but not more than 45 days after it has received the request.", "sig": {"type": "request", "text": "a request for access to records"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution, or SEA or its component", "mod": "duty", "act": ["comply with", "a request for access to records"], "cp": "ACT-parent-or-eligible-student?", "time": {"kind": "deadline", "amount": 45, "unit": "days", "from": "signal", "direction": "after", "text": "within a reasonable period of time, but not more than 45 days after it has received the request"}}
{"p": "99.10.c", "q": "The educational agency or institution, or SEA or its component shall respond to reasonable requests for explanations and interpretations of the records.", "sig": {"type": "request", "text": "a reasonable request for explanations and interpretations of the records"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution, or SEA or its component", "mod": "duty", "act": ["respond to", "reasonable requests for explanations and interpretations of the records"], "cp": "ACT-parent-or-eligible-student?"}
{"p": ["99.10.d", "99.10.d.1", "99.10.d.2"], "q": "If circumstances effectively prevent the parent or eligible student from exercising the right to inspect and review the student’s education records, the educational agency or institution, or SEA or its component, shall", "sig": {"type": "state", "text": "circumstances effectively prevent the parent or eligible student from exercising the right to inspect and review the student’s education records"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution, or SEA or its component", "mod": "duty", "act": ["provide a copy of the records requested, or make other arrangements for inspection and review", "the parent or eligible student"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.10.e", "q": "The educational agency or institution, or SEA or its component shall not destroy any education records if there is an outstanding request to inspect and review the records under this section.", "sig": {"type": "state", "text": "there is an outstanding request to inspect and review the records"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution, or SEA or its component", "mod": "prohibition", "act": ["destroy", "any education records"], "cp": "ACT-parent-or-eligible-student?"}
{"p": "99.10.f", "q": "the student may have those records reviewed by a physician or other appropriate professional of the student’s choice", "sig": {"type": "discretionary", "text": "the student may have those records reviewed …"}, "actor": "ACT-eligible-student|the student", "mod": "permission", "act": ["have reviewed by a physician or other appropriate professional of the student’s choice", "treatment records under paragraph (b)(4) of the definition of Education records in § 99.3"], "flags": ["O-AMBIG"]}
{"p": "99.11.a", "q": "an educational agency or institution may charge a fee for a copy of an education record which is made for the parent or eligible student", "sig": {"type": "discretionary", "text": "an educational agency or institution may charge a fee …"}, "actor": "ACT-educational-agency-or-institution|an educational agency or institution", "mod": "permission", "act": ["charge a fee for", "a copy of an education record which is made for the parent or eligible student"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "cond": ["unless the imposition of a fee effectively prevents a parent or eligible student from exercising the right to inspect and review the student’s education records"]}
{"p": "99.11.b", "q": "An educational agency or institution may not charge a fee to search for or to retrieve the education records of a student.", "sig": {"type": "standing", "text": "An educational agency or institution may not charge a fee …"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "prohibition", "act": ["charge a fee", "to search for or to retrieve the education records of a student"], "cp": "ACT-parent-or-eligible-student?"}
{"p": ["99.12.c.2", "99.12.c.2.i"], "q": "Give the student, on request, the names of the individuals who provided the letters and statements of recommendation; and", "sig": {"type": "request", "text": "a student who has waived the right to inspect and review confidential letters asks for the names of the individuals who provided them"}, "actor": "ACT-educational-agency-or-institution|The educational institution", "mod": "duty", "act": ["give", "the names of the individuals who provided the letters and statements of recommendation"], "cp": "ACT-student|the student", "cond": ["the student has waived his or her rights under paragraph (b)(3)(i)"]}
{"p": "99.12.c.2.ii", "q": "Use the letters and statements of recommendation only for the purpose for which they were intended.", "sig": {"type": "state", "text": "a student has waived his or her rights under paragraph (b)(3)(i)"}, "actor": "ACT-educational-agency-or-institution|The educational institution", "mod": "duty", "act": ["use", "the letters and statements of recommendation only for the purpose for which they were intended"]}
{"p": "99.12.c.3.i", "q": "A waiver under paragraph (b)(3)(i) of this section may be revoked with respect to any actions occurring after the revocation.", "sig": {"type": "discretionary", "text": "A waiver … may be revoked"}, "actor": null, "mod": "permission", "act": ["revoke", "a waiver under paragraph (b)(3)(i), with respect to any actions occurring after the revocation"], "flags": ["O-ACT"]}
{"p": "99.12.c.3.ii", "q": "A revocation under paragraph (c)(3)(i) of this section must be in writing.", "sig": {"type": "event", "text": "a waiver is revoked under paragraph (c)(3)(i)", "ref": "99.12.c.3.i"}, "actor": null, "mod": "duty", "act": ["make in writing", "the revocation of a waiver"], "flags": ["O-ACT"]}
{"p": "99.20.a", "q": "If a parent or eligible student believes the education records relating to the student contain information that is inaccurate, misleading, or in violation of the student’s rights of privacy, he or she may ask the educational agency or institution to amend the record.", "sig": {"type": "state", "text": "the parent or eligible student believes the education records contain information that is inaccurate, misleading, or in violation of the student’s rights of privacy"}, "actor": "ACT-parent-or-eligible-student|a parent or eligible student", "mod": "permission", "act": ["ask to amend", "the record"], "cp": "ACT-educational-agency-or-institution|the educational agency or institution", "out": ["artifact:amendment-request"]}
{"p": "99.20.b", "q": "The educational agency or institution shall decide whether to amend the record as requested within a reasonable time after the agency or institution receives the request.", "sig": {"type": "upstream_action", "text": "the agency or institution receives the request to amend", "ref": "99.20.a"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution", "mod": "duty", "act": ["decide whether to amend", "the record as requested"], "cp": "ACT-parent-or-eligible-student?", "time": {"kind": "deadline", "from": "signal", "direction": "after", "text": "within a reasonable time after the agency or institution receives the request"}, "out": ["artifact:amendment-decision"]}
{"p": "99.20.c", "q": "If the educational agency or institution decides not to amend the record as requested, it shall inform the parent or eligible student of its decision and of his or her right to a hearing under § 99.21.", "sig": {"type": "upstream_action", "text": "the agency or institution decides not to amend the record as requested", "ref": "99.20.b"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution", "mod": "duty", "act": ["inform", "the parent or eligible student of its decision and of his or her right to a hearing under § 99.21"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.21.a", "q": "An educational agency or institution shall give a parent or eligible student, on request, an opportunity for a hearing to challenge the content of the student’s education records on the grounds that the information contained in the education records is inaccurate, misleading, or in violation of the privacy rights of the student.", "sig": {"type": "request", "text": "a parent or eligible student requests a hearing"}, "actor": "ACT-educational-agency-or-institution|An educational agency or institution", "mod": "duty", "act": ["give an opportunity for a hearing to challenge", "the content of the student’s education records on the grounds that the information is inaccurate, misleading, or in violation of the privacy rights of the student"], "cp": "ACT-parent-or-eligible-student|a parent or eligible student", "out": ["artifact:hearing"]}
{"p": ["99.21.b.1", "99.21.b.1.i"], "q": "If, as a result of the hearing, the educational agency or institution decides that the information is inaccurate, misleading, or otherwise in violation of the privacy rights of the student, it shall", "sig": {"type": "upstream_action", "text": "the agency or institution decides after the hearing that the information is inaccurate, misleading, or otherwise in violation of the privacy rights of the student", "ref": "99.22.e"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution", "mod": "duty", "act": ["amend", "the record accordingly"]}
{"p": "99.21.b.1.ii", "q": "Inform the parent or eligible student of the amendment in writing.", "sig": {"type": "upstream_action", "text": "the agency or institution amends the record after the hearing", "ref": "99.21.b.1"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution", "mod": "duty", "act": ["inform in writing", "the parent or eligible student of the amendment"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.21.b.2", "q": "If, as a result of the hearing, the educational agency or institution decides that the information in the education record is not inaccurate, misleading, or otherwise in violation of the privacy rights of the student, it shall inform the parent or eligible student of the right to place a statement in the record commenting on the contested information in the record or stating why he or she disagrees with the decision of the agency or institution, or both.", "sig": {"type": "upstream_action", "text": "the agency or institution decides after the hearing that the information is not inaccurate, misleading, or otherwise in violation of the privacy rights of the student", "ref": "99.22.e"}, "actor": "ACT-educational-agency-or-institution|the educational agency or institution", "mod": "duty", "act": ["inform", "the parent or eligible student of the right to place a statement in the record commenting on the contested information or stating why he or she disagrees with the decision"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": ["99.21.c", "99.21.c.1"], "q": "If an educational agency or institution places a statement in the education records of a student under paragraph (b)(2) of this section, the agency or institution shall", "sig": {"type": "event", "text": "a statement is placed in the education records of a student under paragraph (b)(2)"}, "actor": "ACT-educational-agency-or-institution|the agency or institution", "mod": "duty", "act": ["maintain", "the statement with the contested part of the record for as long as the record is maintained"]}
{"p": "99.21.c.2", "q": "Disclose the statement whenever it discloses the portion of the record to which the statement relates.", "sig": {"type": "event", "text": "the agency or institution discloses the portion of the record to which the statement relates"}, "actor": "ACT-educational-agency-or-institution|the agency or institution", "mod": "duty", "act": ["disclose", "the statement together with the portion of the record to which it relates"]}
{"p": ["99.22", "99.22.a"], "q": "The educational agency or institution shall hold the hearing within a reasonable time after it has received the request for the hearing from the parent or eligible student.", "sig": {"type": "upstream_action", "text": "the agency or institution receives the request for the hearing", "ref": "99.21.a"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution", "mod": "duty", "act": ["hold", "the hearing"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "time": {"kind": "deadline", "from": "signal", "direction": "after", "text": "within a reasonable time after it has received the request for the hearing"}}
{"p": "99.22.b", "q": "The educational agency or institution shall give the parent or eligible student notice of the date, time, and place, reasonably in advance of the hearing.", "sig": {"type": "upstream_action", "text": "the agency or institution is to hold the hearing", "ref": "99.22"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution", "mod": "duty", "act": ["give notice of", "the date, time, and place of the hearing"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student", "time": {"kind": "deadline", "direction": "before", "text": "reasonably in advance of the hearing"}}
{"p": "99.22.c", "q": "The hearing may be conducted by any individual, including an official of the educational agency or institution, who does not have a direct interest in the outcome of the hearing.", "sig": {"type": "upstream_action", "text": "the hearing is to be held", "ref": "99.22"}, "actor": null, "mod": "permission", "act": ["conduct", "the hearing, if the individual does not have a direct interest in its outcome"], "flags": ["O-ACT"]}
{"p": "99.22.d", "q": "The educational agency or institution shall give the parent or eligible student a full and fair opportunity to present evidence relevant to the issues raised under § 99.21.", "sig": {"type": "upstream_action", "text": "the hearing is held", "ref": "99.22"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution", "mod": "duty", "act": ["give a full and fair opportunity to present", "evidence relevant to the issues raised under § 99.21"], "cp": "ACT-parent-or-eligible-student|the parent or eligible student"}
{"p": "99.22.d", "q": "The parent or eligible student may, at their own expense, be assisted or represented by one or more individuals of his or her own choice, including an attorney.", "sig": {"type": "upstream_action", "text": "the hearing is held", "ref": "99.22"}, "actor": "ACT-parent-or-eligible-student|The parent or eligible student", "mod": "permission", "act": ["be assisted or represented", "at the hearing, at their own expense, by one or more individuals of his or her own choice, including an attorney"]}
{"p": "99.22.e", "q": "The educational agency or institution shall make its decision in writing within a reasonable period of time after the hearing.", "sig": {"type": "upstream_action", "text": "the hearing has been held", "ref": "99.22"}, "actor": "ACT-educational-agency-or-institution|The educational agency or institution", "mod": "duty", "act": ["make its decision in writing", "the decision on the contested record"], "cp": "ACT-parent-or-eligible-student?", "time": {"kind": "deadline", "from": "signal", "direction": "after", "text": "within a reasonable period of time after the hearing"}, "out": ["artifact:hearing-decision"]}
{"p": "99.22.f", "q": "The decision must be based solely on the evidence presented at the hearing, and must include a summary of the evidence and the reasons for the decision.", "sig": {"type": "upstream_action", "text": "the agency or institution makes its decision after the hearing", "ref": "99.22.e"}, "actor": null, "mod": "duty", "act": ["base the decision solely on the evidence presented at the hearing, and include a summary of the evidence and the reasons", "the decision"], "flags": ["O-ACT"]}
